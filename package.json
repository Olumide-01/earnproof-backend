{
  "name": "earnproof-backend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "EarnProof API service for Stellar income proof generation and verification.",
  "engines": {
    "node": ">=20.11.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "npm run hooks:install",
    "hooks:install": "node scripts/install-git-hooks.js",
    "build": "prisma generate && nest build",
    "postbuild": "node --check dist/main.js",
    "prestart": "npm run prisma:migrate:deploy",
    "start": "node dist/main.js",
    "start:nest": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:serial": "jest --config jest.integration.config.js --runInBand",
    "test:performance": "jest --config jest.performance.config.js --runInBand",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:e2e:serial": "jest --config jest.e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:demo": "ts-node prisma/seed-demo.ts",
    "backfill:audit-chain": "ts-node scripts/migrations/backfill-audit-log-chain.ts",
    "db:reset": "ts-node prisma/reset.ts",
    "backfill:payment-identity": "ts-node scripts/backfill-payment-identity.ts",
    "drill:verify": "ts-node scripts/backup/verify-backup-format.ts",
    "payments:backfill-addresses": "ts-node scripts/payments/backfill-payment-addresses.ts",
    "webhook:conformance": "ts-node scripts/webhook-receiver/conformance.ts",
    "credential:conformance": "ts-node scripts/credential-verifier/conformance.ts",
    "migration:safety": "ts-node scripts/migration-safety.ts",
    "webhook:receiver": "ts-node scripts/webhook-receiver/receiver.ts",
    "sbom:generate": "ts-node scripts/sbom/generate.ts",
    "sbom:check": "ts-node scripts/sbom/check.ts"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@stellar/stellar-base": "^15.0.0",
    "@stellar/stellar-sdk": "16.2.0",
    "@types/express": "^5.0.6",
    "ajv": "^8.17.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "helmet": "^8.1.0",
    "prisma": "^6.19.3",
    "range_check": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.30.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.2",
    "@types/range_check": "^1.4.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "js-yaml": "5.2.3"
  }
}
