generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WORKER
  ISSUER
  ADMIN
  DEVELOPER
}

enum ResourceStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REVOKED
  DELETED
  // Reached only by attestations, when the expiration reconciler moves an
  // ACTIVE attestation past its expiry. Other resources never take this value.
  EXPIRED
}

enum PaymentClassification {
  INCOME
  REIMBURSEMENT
  PERSONAL_TRANSFER
  UNKNOWN
  EXCLUDED
}

enum ProofStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INVALID
}

enum ProofType {
  MINIMUM_INCOME
  RECURRING_INCOME
  PAYMENT_RECEIPT
  INCOME_RANGE
  EMPLOYER_PAYMENT
  EMPLOYMENT_CONTINUITY
  INVOICE_SETTLEMENT
  AGGREGATE_EARNINGS
}

enum AttestationType {
  PAYMENT
  EMPLOYMENT
  INVOICE
}

enum VerificationResult {
  VALID
  EXPIRED
  REVOKED
  INVALID_SIGNATURE
  UNKNOWN_PROOF
  UNVERIFIED_ISSUER
}

enum VerificationOutcome {
  VALID
  EXPIRED
  REVOKED
  UNKNOWN
  INVALID_SIGNATURE
  ISSUER_WARNING
}

/// Approval state of a purpose declaration. A declaration must be APPROVED
/// and not expired or revoked to pass verification enforcement.
enum PurposeDeclarationApprovalState {
  PENDING
  APPROVED
  REVOKED
  EXPIRED
}

/// Lifecycle of an issuer address rotation. The database adopts the new
/// address only on CONFIRMED, after the contract is observed to hold it.
enum IssuerAddressRotationStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum PaymentSyncCheckpointStatus {
  VERIFIED
  DIVERGED
}

enum AnchoringOperation {
  REGISTER
  REVOKE
}

/// The class of principal that revoked a proof. Safe to expose publicly:
/// it says who acted, never who they are.
enum RevocationActorType {
  OWNER
  ADMIN
}

/// A closed, public-safe taxonomy for why a proof was revoked. Kept
/// separate from any free-form private reason so the verification API can
/// disclose *why* without disclosing operator notes.
enum RevocationReasonCode {
  OWNER_REQUESTED
  DATA_CORRECTION
  FRAUD_SUSPECTED
  COMPLIANCE_HOLD
  DUPLICATE_PROOF
  OTHER
}

enum AnchoringStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  /// Terminal for automatic retries: the worker stops touching this intent.
  /// Only a redrive (back to PENDING) or an explicit abandonment moves it
  /// out of this state.
  QUARANTINED
}

/// Why an anchoring intent was quarantined. Distinct from the free-form
/// `lastErrorSafe` text so operators and dashboards can group without
/// parsing prose, and so the value is guaranteed already-redacted.
enum QuarantineReasonCode {
  /// The input itself cannot succeed no matter how many times it is retried
  /// (e.g. malformed commitment, invalid contract id).
  POISON_INPUT
  /// The chain explicitly rejected the operation (e.g. already registered,
  /// unauthorized, contract not found).
  CHAIN_REJECTED
  /// Exhausted the worker's automatic retry budget without a permanent
  /// chain-level rejection.
  MAX_ATTEMPTS_EXCEEDED
  /// Flagged by the reconciler for a state disagreement it cannot repair
  /// automatically.
  MANUAL_REVIEW
}

/// An operator's disposition of a quarantined intent. PENDING means no
/// decision has been made yet.
enum QuarantineDecision {
  PENDING
  REDRIVEN
  ABANDONED
}

enum AuthEventType {
  CHALLENGE_CREATED
  CHALLENGE_VERIFIED
  SIGNATURE_INVALID
  CHALLENGE_EXPIRED
  CHALLENGE_REPLAYED
  RATE_LIMITED
  ACCOUNT_INACTIVE
}

enum EncryptionKeyRewrapStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EncryptionKeyRetirementStatus {
  PENDING
  GUARDING
  SAFE_TO_RETIRE
  FAILED
}

enum ApiKeyScope {
  // Proof verification and reading
  PROOF_READ
  PROOF_VERIFY

  // Offline bundles (bounded offline verification)
  BUNDLES_CREATE

  // Payment management and reading
  PAYMENT_READ
  PAYMENT_WRITE

  // Organization management
  ORG_READ
  ORG_ADMIN
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum WalletRotationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum SharingOutcome {
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
  REPLAYED
  TOKEN_GENERATED
  EXPIRED_TOKEN
  INVALID_TOKEN
  PROOF_NOT_FOUND
  PROOF_INACTIVE
  SUCCESS
  ERROR
}

/// Versioned source types that contributed to a verification decision
enum VerificationProvenanceSourceType {
  /// Credential: payment, attestation, trusted source, or proof claim
  CREDENTIAL_SOURCE
  /// Backend observation: payment sync checkpoint, classification, policy
  BACKEND_OBSERVATION
  /// Contract observation: on-chain proof status (revoked, valid)
  CONTRACT_OBSERVATION
  /// Stellar observation: Horizon operation, ledger finality, fee
  STELLAR_OBSERVATION
}

enum PolicyType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum ConsentAction {
  ACCEPT
  WITHDRAW
}

enum MembershipImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum MembershipImportRowResult {
  ACCEPTED
  NO_OP
  REJECTED
  FAILED
}

enum AccessReviewCampaignStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum AccessReviewDecision {
  CONFIRM
  ROLE_CHANGE
  REMOVE
}

enum WebhookCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

/// Closed taxonomy of why a credential was quarantined.
/// Safe to expose publicly in verification API responses.
enum CredentialQuarantineReasonCode {
  MALFORMED
  UNKNOWN_KEY
  POLICY_CONFLICT
  TRUST_NOT_ESTABLISHED
  SUSPICIOUS
}

/// State machine for credential quarantine lifecycle.
/// QUARANTINED → RELEASED | REJECTED | EXPIRED (terminal states)
enum CredentialQuarantineState {
  QUARANTINED
  RELEASED
  REJECTED
  EXPIRED
}

model User {
  id                      String                 @id @default(cuid())
  walletAddress           String                 @unique
  walletHash              String                 @unique
  role                    UserRole               @default(WORKER)
  status                  ResourceStatus         @default(ACTIVE)
  /// Optional self-managed display label. The only profile field a user may edit.
  displayName             String?                @db.VarChar(64)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  lastLoginAt             DateTime?
  organizations           Organization[]
  payments                Payment[]
  paymentSyncCheckpoint   PaymentSyncCheckpoint?
  trustedSources          TrustedSource[]
  proofs                  Proof[]
  createdApiKeys          ApiKey[]
  sessions                AuthSession[]
  walletRotations         WalletRotation[]
  organizationMemberships OrganizationMember[]   @relation("organizationMemberships")
  paymentBackfillJobs     PaymentBackfillJob[]
  createdImportJobs       MembershipImportJob[]  @relation("CreatedImportJobs")
  createdAccessReviews    AccessReviewCampaign[] @relation("CreatedAccessReviews")
  reviewedAccessEntries   AccessReviewEntry[]    @relation("ReviewedAccessEntries")
  consentRecords          ConsentRecord[]
  paymentCheckpointHealthSnapshots PaymentCheckpointHealthSnapshot[]
  proofExpirationReminderPreference ProofExpirationReminderPreference?
  quarantineDecisions     CredentialQuarantine[]      @relation("quarantine_decidedBy")
  quarantineImports       CredentialQuarantine[]      @relation("quarantine_importedBy")
  quarantineAuditEvents   CredentialQuarantineAudit[] @relation("quarantine_audit_actor")
  proofExpirationReminderDeliveries ProofExpirationReminderDelivery[]
  sessionRiskEvents       SessionRiskEvent[]
  declarationsApproved    PurposeDeclaration[]  @relation("declaration_approvedBy")
  declarationsRevoked     PurposeDeclaration[]  @relation("declaration_revokedBy")
  auditEntries            DeclarationAuditEntry[]

  @@index([walletHash])
  @@index([status])
}

model WalletChallenge {
  id                String    @id @default(cuid())
  walletAddress     String
  nonceHash         String    @unique
  message           String
  expiresAt         DateTime
  usedAt            DateTime?
  networkPassphrase String? /// Stellar network passphrase committed at challenge creation. Null for legacy challenges.
  origin            String? /// Normalized application origin committed at challenge creation. Null for legacy challenges.
  createdAt         DateTime  @default(now())

  @@index([walletAddress])
  @@index([expiresAt])
}

/// Persisted, revocable authentication session.
/// Only a SHA-256 hash of the opaque bearer token is stored — the raw token is never
/// written to the database or to any application log.
model AuthSession {
  id                String       @id @default(cuid())
  /// SHA-256 hex digest of the raw opaque session token.
  tokenHash         String       @unique
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  /// Wallet identity (User.walletHash) the session was issued to. A session
  /// whose wallet no longer matches the account is refused. Null for sessions
  /// issued before wallet rotation existed.
  walletHash        String?
  createdAt         DateTime     @default(now())
  expiresAt         DateTime
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  deviceLabel       String?
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  /// Optional device fingerprint for session inventory (e.g., user-agent hash, IP hash).
  deviceFingerprint String?
  /// Optional reason for revocation (e.g., "REMOTE_REVOCATION", "DEVICE_LOSS").
  revocationReason  String?
  /// Links to the replacement session produced during rotation.
  rotatedToId       String?      @unique
  rotatedTo         AuthSession? @relation("SessionRotation", fields: [rotatedToId], references: [id])
  rotatedFrom       AuthSession? @relation("SessionRotation")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([deviceFingerprint])
}

/// One-time wallet address rotation.
///
/// Both the current and the replacement key sign distinct messages bound to
/// the network, the application origin and a single-use nonce; the nonce's
/// hash is unique across rotations. A rotation is consumed before its
/// signatures are checked, so it can be attempted at most once; the account's
/// identity changes only when both signatures verify.
model WalletRotation {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id])
  currentWalletAddress String
  newWalletAddress     String
  nonceHash            String               @unique
  currentMessage       String
  newMessage           String
  networkPassphrase    String
  origin               String
  status               WalletRotationStatus @default(PENDING)
  /// Bounded failure code; never a signature or raw error.
  failureReason        String?
  expiresAt            DateTime
  consumedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())

  @@index([userId, status])
  @@index([expiresAt])
}

model Organization {
  id                   String                    @id @default(cuid())
  name                 String
  slug                 String                    @unique
  website              String?
  status               ResourceStatus            @default(PENDING)
  revision             Int                       @default(0)
  createdById          String
  createdBy            User                      @relation(fields: [createdById], references: [id])
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  /// Set while the organization is archived. Every privileged operation on
  /// the organization and its keys, webhooks and issuers is refused while set.
  /// Cleared on restore; kept on deletion.
  archivedAt           DateTime?
  /// Set while a legal hold forbids deletion. Released explicitly.
  legalHoldAt          DateTime?
  /// Bounded case or matter reference for the legal hold.
  legalHoldReference   String?                   @db.VarChar(64)
  /// Set when the organization is deleted. The row survives as a tombstone
  /// so issuers, attestations and audit records keep resolving.
  deletedAt            DateTime?
  issuers              Issuer[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  quotaUsage           OrganizationQuotaUsage[]
  auditLogs            AuditLog[]
  members              OrganizationMember[]
  idempotencyRecords   IdempotencyRecord[]
  proofSharingEvents   ProofSharingEvent[]
  consentRecords       ConsentRecord[]
  disclosureReceipts   DisclosureReceipt[]
  membershipImports    MembershipImportJob[]
  accessReviews        AccessReviewCampaign[]
  supportedAssets      SupportedAsset[]
  disputes             ProofDispute[]
  exportJobs           OrganizationExportJob[]
  residencyPolicies    DataResidencyPolicy[]
  residencyAssignments DataResidencyAssignment[]
  schemaImportJobs     SchemaImportJob[]
  supportAccessGrants  SupportAccessGrant[]
  paymentCheckpointHealthSnapshots PaymentCheckpointHealthSnapshot[]
  transactionConfirmations TransactionConfirmation[]
  domainEventsOutbox       DomainEventOutbox[]
  bulkAdminJobs        BulkAdminJob[]
  securityNotifications SecurityNotification[]
  purposeDefinitions   PurposeDefinition[]
  purposeDeclarations  PurposeDeclaration[]
  verificationPolicies VerificationPolicy[]
  credentialVerificationKeyTrustPins CredentialVerificationKeyTrustPin[]
  credentialQuarantines CredentialQuarantine[]
  credentialQuarantineAudits CredentialQuarantineAudit[] @relation("quarantine_audit_org")
  roleApprovalPolicies OrganizationRoleApprovalPolicy[]
  auditLegalHolds      AuditLegalHold[]

  @@index([status])
  @@index([archivedAt])
}

model OrganizationMember {
  id                  String                 @id @default(cuid())
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId              String
  user                User                   @relation("organizationMemberships", fields: [userId], references: [id], onDelete: Restrict)
  role                OrganizationMemberRole
  status              ResourceStatus         @default(ACTIVE)
  joinedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  accessReviewEntries AccessReviewEntry[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
}

/// Stores idempotency records to prevent duplicate mutations within an organization.
/// Indexed by (organizationId, idempotencyKey) to enforce uniqueness and enable O(1) lookup.
/// The requestFingerprint is checked on incoming requests; if the key exists but fingerprint
/// differs, the request is rejected with a 409 Conflict.
model IdempotencyRecord {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// User-supplied idempotency key from the request header.
  idempotencyKey     String            @db.VarChar(255)
  /// Hash of the request: method + path + body (to detect payload conflicts).
  requestFingerprint String
  /// Lifecycle: PENDING → COMPLETED | FAILED
  status             IdempotencyStatus @default(PENDING)
  /// The response body, with secrets stripped (JSON serialized).
  responseBody       Json?
  /// HTTP status code of the stored response (e.g., 201, 200).
  responseStatusCode Int?
  /// Timestamp when this record should be considered expired (for cleanup).
  expiresAt          DateTime
  /// Typed operation name (e.g. PROOF_CREATE, PAYMENT_SYNC).
  operationType      String?           @db.VarChar(64)
  /// Target resource type associated with this operation.
  resourceType       String?           @db.VarChar(64)
  /// Target resource identifier.
  resourceId         String?           @db.VarChar(128)
  /// Read-after-write consistency token issued on completion.
  consistencyToken   String?
  /// Number of invocation attempts under this key.
  attemptCount       Int               @default(1)
  /// Reason when cancelled.
  cancellationReason String?
  /// Additional operation metadata.
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  /// Unique constraint on (organizationId, idempotencyKey) to prevent duplicate keys within an org.
  /// Also serves as the compound index for fast lookups.
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, expiresAt])
  @@index([organizationId, resourceType, resourceId])
}

model Issuer {
  id                      String                   @id @default(cuid())
  organizationId          String
  organization            Organization             @relation(fields: [organizationId], references: [id])
  stellarAddress          String                   @unique
  status                  ResourceStatus           @default(PENDING)
  /// Optimistic-concurrency revision, incremented by every administrative
  /// change. Address rotation requests must name the revision they were based
  /// on, so a command built from a stale view of the issuer is rejected.
  revision                Int                      @default(0)
  metadataHash            String?
  publicMetadata          Json?
  contractSyncState       String                   @default("PENDING")
  contractSyncedStatus    ResourceStatus?
  contractTransactionHash String?
  contractSyncedAt        DateTime?
  contractSyncError       String?
  verifiedAt              DateTime?
  suspendedAt             DateTime?
  revokedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  trustedSources          TrustedSource[]
  attestations            Attestation[]
  addressRotations        IssuerAddressRotation[]
  addressHistory          IssuerAddressHistory[]
  policyCommitments       IssuerPolicyCommitment[]
  invoiceSettlements      ProofInvoiceSettlement[]
  signingKeys             IssuerSigningKey[]
  credentialVerificationKeyTrustPins CredentialVerificationKeyTrustPin[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, createdAt, id])
  @@index([status, createdAt, id])
}

/// A requested change of an issuer's Stellar address, reconciled against the
/// on-chain issuer registry before the database adopts it.
model IssuerAddressRotation {
  id               String                      @id @default(cuid())
  issuerId         String
  issuer           Issuer                      @relation(fields: [issuerId], references: [id])
  fromAddress      String
  toAddress        String
  /// Issuer revision the request was based on.
  expectedRevision Int
  status           IssuerAddressRotationStatus @default(PENDING)
  /// Set to the issuer id while the rotation is open, cleared when it closes:
  /// the unique index allows at most one open rotation per issuer.
  openIssuerKey    String?                     @unique
  /// Set to the target address while the rotation is open: two issuers can
  /// never be rotating onto the same address at once.
  openTargetKey    String?                     @unique
  requestedById    String
  attemptCount     Int                         @default(0)
  lastAttemptAt    DateTime?
  nextAttemptAt    DateTime?
  /// Lease held by the process currently reconciling this rotation.
  leaseExpiresAt   DateTime?
  transactionHash  String?
  /// Bounded failure code; never raw CLI output.
  lastError        String?
  confirmedAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([issuerId, createdAt])
  @@index([status, nextAttemptAt])
}

/// An address an issuer used to hold. Kept so attestations and on-chain
/// events signed or registered under a retired address stay attributable.
model IssuerAddressHistory {
  id              String   @id @default(cuid())
  issuerId        String
  issuer          Issuer   @relation(fields: [issuerId], references: [id])
  stellarAddress  String
  retiredAt       DateTime
  rotationId      String   @unique
  transactionHash String?

  @@index([issuerId, retiredAt])
  @@index([stellarAddress])
}

/// Immutable audit trail of issuer policy versions with deterministic commit hashes.
/// Tracks exact issuer policy commitment version effective at proof issuance (#307).
/// Captures issuer state (signing key, metadata, address) at each policy change.
///
/// Pattern: Similar to SupportedAsset → assetPolicySnapshot. Each issuer change
/// creates a new commitment row; proofs reference the commitment by ID, enabling
/// proof verification even after the issuer policy changes.
model IssuerPolicyCommitment {
  id                String   @id @default(cuid())
  issuerId          String
  issuer            Issuer   @relation(fields: [issuerId], references: [id])
  
  /// Version tracking: incremental per issuer. Monotonically increasing.
  /// Combined with issuerId, enforces: reordered events cannot regress versions.
  version           Int
  
  /// Commitment identification
  /// SHA-256 hash of canonicalized policy inputs: "sha256:<hex>"
  /// Deterministic: identical policy → identical hash → prevents duplicate rows.
  commitment        String
  /// SHA-256 hash of the canonical policy JSON snapshot for deduplication.
  policyInputsHash  String
  
  /// Policy snapshot (immutable after creation)
  /// Complete issuer state at this version: {signingKeyVersionId, address, metadata, ...}
  /// Frozen at issuance time; proofs reference this snapshot, enabling verification
  /// even if the live Issuer row later changes/deletes.
  policySnapshot    Json
  
  /// Lifecycle markers
  effectiveAt       DateTime
  supersededAt      DateTime?  // NULL = current active commitment
  
  /// Audit & correlation
  /// Links to domain event or audit log entry for full change history
  correlationId     String?
  createdAt         DateTime   @default(now())
  
  // Proofs that reference this commitment
  proofs            Proof[]    @relation("ProofIssuerPolicyCommitment")

  /// Unique constraints
  /// Prevents version gaps and regressions: (issuerId, version) must be unique
  @@unique([issuerId, version])
  /// Prevents duplicate commits: commitment hash is globally unique
  @@unique([commitment])
  
  /// Indexes for common queries
  /// Current commitment: WHERE issuerId = ? AND supersededAt IS NULL
  @@index([issuerId, effectiveAt])
  /// Historical queries: WHERE issuerId = ? AND supersededAt IS NOT NULL
  @@index([issuerId, supersededAt])
  /// Lookups by commitment: WHERE commitment = ?
  @@index([commitment])
}

model SupportedAsset {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  assetKey       String
  code           String
  issuer         String?
  network        String
  decimals       Int            @default(7)
  status         ResourceStatus @default(ACTIVE)
  revision       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, assetKey])
  @@index([organizationId, status])
  @@index([network, status])
}

model Payment {
  id                          String                         @id @default(cuid())
  userId                      String
  user                        User                           @relation(fields: [userId], references: [id])
  network                     String?
  stellarTransactionHash      String
  operationId                 String                         @unique
  /// Legacy plaintext. Never written by current code; cleared by the address
  /// backfill once the ciphertext is verified. Drop in a later release.
  sourceAddress               String?
  /// Legacy plaintext; see sourceAddress.
  destinationAddress          String?
  /// aenc:v<N>:... AES-256-GCM ciphertext, field-bound. See protected-address.ts.
  sourceAddressEncrypted      String?
  destinationAddressEncrypted String?
  /// hmac:v<N>:... keyed lookup token for equality queries on the sender.
  sourceAddressLookup    String?
  operationIndex         Int?
  pagingToken            String?
  ledgerSequence         Int?
  finalityHoldAt         DateTime?
  finalityHoldReason     String?
  assetCode              String
  assetIssuer            String?
  amountEncrypted        String?
  occurredAt             DateTime
  /// Versioned memo (v2): {version, type, ciphertext} or {version, type: "none", omitted?}.
  /// Plaintext is never stored. See src/payments/payment-memo.ts and docs/payment-memos.md.
  memo                   Json?
  classification         PaymentClassification @default(UNKNOWN)
  classificationRevision Int                   @default(1)
  isEligible             Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  invoiceSettlement      ProofInvoiceSettlement?
  classificationHistory  PaymentClassificationHistory[]
  eligibilityDecisions   PaymentEligibilityDecision[]

  // Canonical identity of an indexed payment. A transaction hash alone is not
  // enough — one transaction can hold several payment operations — so network,
  // hash, and operation index together identify a payment. Nullable columns
  // plus a composite unique let existing rows be backfilled deterministically
  // before the identity is enforced; see the migration and
  // scripts/backfill-payment-identity.ts.
  @@unique([network, stellarTransactionHash, operationIndex], name: "payment_network_tx_op")
  @@index([userId, occurredAt])
  @@index([userId, ledgerSequence])
  @@index([userId, occurredAt, id])
  @@index([sourceAddress])
  @@index([sourceAddressLookup])
  @@index([assetCode, assetIssuer])
  @@index([classification])
}

/// One evaluation of a payment's eligibility under a versioned policy.
/// Exactly one decision per payment is active; superseded decisions are kept
/// for audit. Stores derived factors and reason codes only: never a memo,
/// an amount, or a counterparty address.
model PaymentEligibilityDecision {
  id            String    @id @default(cuid())
  paymentId     String
  payment       Payment   @relation(fields: [paymentId], references: [id])
  /// Denormalised owner, so owner-scoped reads never need a join.
  userId        String
  policyVersion String
  eligible      Boolean
  factors       Json
  reasonCodes   String[]
  /// sha256 of (policyVersion, factors). Equal hashes mean an identical decision.
  inputsHash    String
  trigger       String
  evaluatedAt   DateTime
  supersededAt  DateTime?
  /// TRUE for the active decision, NULL once superseded. The unique index on
  /// (paymentId, isActive) lets PostgreSQL itself refuse a second active
  /// decision, because NULLs never collide.
  isActive      Boolean?
  createdAt     DateTime  @default(now())

  @@unique([paymentId, isActive])
  @@index([paymentId, evaluatedAt])
  @@index([userId, isActive])
  @@index([policyVersion, isActive])
}

/// Last verified position in a wallet's Horizon payments feed.
/// Records the ledger sequence and hash the checkpoint was taken at, so a later
/// sync can prove Horizon still agrees before it trusts anything past it.
model PaymentSyncCheckpoint {
  id                   String                      @id @default(cuid())
  userId               String                      @unique
  user                 User                        @relation(fields: [userId], references: [id])
  pagingToken          String
  operationId          String
  transactionHash      String
  ledgerSequence       Int
  ledgerHash           String
  status               PaymentSyncCheckpointStatus @default(VERIFIED)
  divergenceReason     String?
  divergedAt           DateTime?
  /// Where a bounded reconciliation read stopped; the next sync continues from here.
  reconciliationCursor String?
  verifiedAt           DateTime
  /// Optimistic concurrency guard: every transition must match the version it read.
  version              Int                         @default(0)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([status])
}

model TrustedSource {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  sourceAddress String
  displayName   String?
  sourceType    String
  issuerId      String?
  issuer        Issuer?        @relation(fields: [issuerId], references: [id])
  status        ResourceStatus @default(ACTIVE)
  revision      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, sourceAddress])
  @@index([issuerId])
  @@index([userId, createdAt, id])
}

model Proof {
  id                      String                  @id @default(cuid())
  userId                  String
  user                    User                    @relation(fields: [userId], references: [id])
  proofType               ProofType
  schemaVersion           String
  status                  ProofStatus             @default(ACTIVE)
  network                 String
  assetCode               String
  assetIssuer             String?
  periodStart             DateTime?
  periodEnd               DateTime?
  expiresAt               DateTime
  commitment              String?
  credentialHash          String                  @unique
  contractTransactionHash String?
  // Snapshot of the SupportedAsset policy that was live-validated at issuance
  // time. Intentionally NOT a foreign key: the registry row may later be
  // deactivated or removed, and an already-issued proof must remain
  // verifiable purely from this snapshot, without re-consulting the
  // (possibly since-changed) live SupportedAsset row.
  assetPolicyId           String?
  assetPolicySnapshot     Json?
  // Snapshot of the issuer policy commitment that was active at proof issuance.
  // Similar to assetPolicySnapshot: enables offline verification even if the
  // issuer policy later changes. Null for proofs issued before this feature.
  issuerPolicyCommitmentId String?
  issuerPolicyCommitment  IssuerPolicyCommitment? @relation("ProofIssuerPolicyCommitment", fields: [issuerPolicyCommitmentId], references: [id])
  // Complete issuer policy snapshot at issuance: {signingKeyVersionId, address, metadata, ...}
  // Immutable after creation; used for offline verification and audit.
  issuerPolicySnapshot    Json?
  revokedAt               DateTime?
  /// Class of principal that revoked this proof. Null until revoked.
  revokedByType           RevocationActorType?
  /// Opaque id of the revoking principal (a user id). Never a wallet
  /// address or other directly-identifying value.
  revokedById             String?
  /// Closed, public-safe reason taxonomy. Null until revoked.
  revocationReasonCode    RevocationReasonCode?
  /// Free-form operator note. Private: never returned from the public
  /// verification endpoint, only from the authorized owner/admin view.
  revocationReasonPrivate String?
  /// Optional fixed-size (sha256) commitment to off-chain revocation
  /// evidence, in the same "sha256:<hex>" form as `commitment`.
  revocationEvidenceHash  String?
  // Renewal / supersession chain. `supersedesId` is unique so a predecessor
  // can have at most one successor: concurrent renewals race on this
  // constraint and exactly one wins, which is what prevents forks.
  supersedesId            String?                 @unique
  supersedes              Proof?                  @relation("ProofSupersession", fields: [supersedesId], references: [id])
  supersededBy            Proof?                  @relation("ProofSupersession")
  supersededAt            DateTime?
  // Hash of the renewal request that produced this successor, so a retried
  // identical request returns the same successor instead of a conflict.
  renewalRequestHash      String?
  /// Set once a revoked proof's anchoring-intent and webhook-delivery channels
  /// have both been observed confirmed (or not applicable) by the revocation
  /// propagation reconciler. Null while revoked and still propagating, and
  /// always null for a non-revoked proof. Bounds the reconciler's work to
  /// proofs that still need it instead of rescanning every revoked proof
  /// forever.
  revocationPropagationConfirmedAt DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  claim                   ProofClaim?
  verificationEvents      VerificationEvent[]
  anchoringIntents        AnchoringIntent[]
  shareTokens             ProofShareToken[]
  invoiceSettlement       ProofInvoiceSettlement?
  verificationProvenance  VerificationProvenance[]
  sharingEvents           ProofSharingEvent[]
  disclosureReceipts      DisclosureReceipt[]
  disputes                ProofDispute[]
  expirationReminderDeliveries ProofExpirationReminderDelivery[]
  verificationProvenances      VerificationProvenance[]

  @@index([userId, status])
  @@index([userId, createdAt, id])
  @@index([proofType])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@index([issuerPolicyCommitmentId])
}

model ProofClaim {
  id                 String   @id @default(cuid())
  proofId            String   @unique
  proof              Proof    @relation(fields: [proofId], references: [id])
  operator           String
  thresholdEncrypted String?
  frequency          String?
  result             Boolean
  disclosurePolicy   Json
  createdAt          DateTime @default(now())
}

/// Binds exactly one confirmed Stellar payment to exactly one invoice-settlement
/// proof. Both `paymentId` and the `[issuerId, invoiceReferenceHash]` pair carry
/// hard uniqueness constraints so that:
///   - the same settled payment can never satisfy two conflicting invoice proofs, and
///   - the same invoice reference (under a given issuer) can never be "settled" twice.
/// These constraints are the actual concurrency guarantee: two simultaneous
/// issuance attempts race on the same Postgres unique index, and only one can win.
/// `invoiceReferenceHash` is a salted/plain SHA-256 commitment over the normalized
/// invoice reference — the raw reference is never persisted here or anywhere else.
model ProofInvoiceSettlement {
  id                   String   @id @default(cuid())
  proofId              String   @unique
  proof                Proof    @relation(fields: [proofId], references: [id])
  paymentId            String   @unique
  payment              Payment  @relation(fields: [paymentId], references: [id])
  issuerId             String
  issuer               Issuer   @relation(fields: [issuerId], references: [id])
  invoiceReferenceHash String
  createdAt            DateTime @default(now())

  @@unique([issuerId, invoiceReferenceHash])
}

model Attestation {
  id                   String          @id @default(cuid())
  issuerId             String
  issuer               Issuer          @relation(fields: [issuerId], references: [id])
  subjectWalletHash    String
  paymentReferenceHash String?
  type                 AttestationType
  schemaVersion        String          @default("1.0")
  signingKeyVersionId  String          @default("1")
  /// Policy version captured at attestation issuance time, for versioned proofs.
  /// Enables proofs to reference the exact attestation policy state when issued.
  /// Null for attestations issued before this feature.
  policyVersion        String?
  status               ResourceStatus  @default(ACTIVE)
  signedPayload        Json
  expiresAt            DateTime?
  revokedAt            DateTime?
  // Last time the expiration reconciler evaluated this attestation. The signed
  // payload and expiresAt are historical evidence and never mutated; only the
  // derived `status` and this marker move when an attestation expires.
  reconciledAt         DateTime?
  revokedBy            String?
  revocationReason     String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([issuerId, status])
  @@index([subjectWalletHash])
  // Drives the reconciliation job: find ACTIVE attestations past their
  // expiry cheaply, without scanning the whole table.
  @@index([issuerId, expiresAt])
  @@index([status, expiresAt])
}

/// Persistent trust pin for credential verification keys.
/// Pins explicitly authorize which issuer verification keys are trusted within a network.
/// - Private keys are never accepted; only public key material is pinned.
/// - A pin is scoped to a single issuer and network; cannot cross issuers or networks.
/// - Compromised pins fail closed: marked REVOKED immediately.
/// - Trust decisions are immutable snapshots at pin time; live key state never mutates them.
model CredentialVerificationKeyTrustPin {
  id                         String          @id @default(cuid())
  /// Organization that owns this trust decision (tenant boundary).
  organizationId             String
  organization               Organization    @relation(fields: [organizationId], references: [id])
  /// Issuer this pin is scoped to (prevents cross-issuer pin misuse).
  issuerId                   String
  issuer                     Issuer          @relation(fields: [issuerId], references: [id])
  /// Network the issuer operates on (Stellar network identifier).
  network                    String
  /// Key ID from the credential verification key being pinned.
  keyId                      String
  /// Immutable snapshot of trusted key material at pin time.
  /// Includes: alg, crv, kid, kty, x (base64url public key), use, status.
  /// Never mutated; survives even if live key state changes.
  trustedKeySnapshot         Json
  /// When this trust decision is effective (usually now, may be backdated).
  effectiveAt                DateTime
  /// When this trust decision expires. Null for perpetual pins.
  expiresAt                  DateTime?
  /// Current status of this pin: ACTIVE (trusted), RETIRED (superceded), REVOKED (compromised).
  status                     CredentialVerificationKeyTrustPinStatus @default(ACTIVE)
  /// Audit context: who made this decision and why.
  decisionMetadata           Json?
  /// Optimistic concurrency: incremented on every status change.
  revision                   Int             @default(0)
  /// When marked REVOKED due to compromise, immutable for forensics.
  revokedAt                  DateTime?
  revokedBy                  String?
  revocationReason           String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  // Composite unique: (organizationId, issuerId, network, keyId, status=ACTIVE)
  // Ensures only one ACTIVE pin per issuer/network/key combination within an org.
  @@unique([organizationId, issuerId, network, keyId, status], name: "active_trust_pin_per_key")
  @@index([organizationId, status])
  @@index([issuerId, network, status])
  @@index([expiresAt, status])
  @@index([createdAt])
  @@index([revokedAt, status])
}

model VerificationEvent {
  id                  String             @id @default(cuid())
  proofId             String
  proof               Proof              @relation(fields: [proofId], references: [id])
  verifierFingerprint String?
  result              VerificationResult
  ipHash              String?
  userAgentHash       String?
  /// Purpose declaration that was validated for this verification (if required by policy).
  declarationId       String?
  declaration         PurposeDeclaration? @relation(fields: [declarationId], references: [id], onDelete: SetNull, name: "verification_declaration")
  /// Version of the declaration at verification time (for audit trail).
  declarationVersion  Int?
  createdAt           DateTime           @default(now())

  @@index([proofId, createdAt])
  @@index([result])
  @@index([declarationId])
}

model VerificationEventLog {
  id           String              @id @default(cuid())
  outcome      VerificationOutcome
  proofId      String
  metadataHash String
  saltVersion  Int
  /// Share token that authorised this verification, when it arrived through a
  /// share link. Only the token row id is recorded — never the raw token or its
  /// hash — so the owner can see how often a link was used without the event
  /// identifying the verifier.
  shareTokenId String?
  createdAt    DateTime            @default(now())
  retainUntil  DateTime

  @@index([proofId, createdAt])
  @@index([outcome])
  @@index([retainUntil])
  @@index([shareTokenId])
}

/// Persisted versioned provenance graph for verification decisions.
/// Captures complete lineage of sources (credential, backend, contract, Stellar)
/// that contributed to verification outcome. Immutable after creation.
/// 
/// Tenant-isolated via proofId foreign key (which constrains to userId).
/// Privacy-safe: contains no source payloads, only identity and hashes.
/// Never changes verification cryptographic outcome.
model VerificationProvenance {
  id          String                          @id @default(cuid())
  proofId     String
  proof       Proof                           @relation(fields: [proofId], references: [id], onDelete: Cascade)
  sourceRecords VerificationProvenanceSource[]
  /// Versioned decision schema (e.g., "earnproof.verification.provenance.v1")
  /// Allows evolution of decision structure over time.
  schemaVersion String
  /// Complete hash of all decision inputs (credential, policy, proof state)
  /// Enables audit/dispute by recomputing with historical data.
  decisionInputHash String
  /// Hashed snapshot of reconstructed credential at verification time.
  /// Enables reproducibility without storing plaintext.
  credentialHash String
  /// Policy version applied to this decision (e.g., "earnproof.minimum-income.policy.v1")
  policyVersion String
  /// Proof status at verification time (ACTIVE, EXPIRED, REVOKED, INVALID)
  proofStatus   String
  /// Final verification result (VALID, EXPIRED, REVOKED, INVALID_SIGNATURE, etc)
  verificationResult String
  /// High-level reason if verification failed or stalled
  /// e.g., "CREDENTIAL_MISMATCH", "MISSING_STELLAR_OBSERVATION", "CONTRACT_REJECTED"
  failureReason String?
  /// Optional: free-form context about missing links or boundary conditions
  /// e.g., "Stellar Horizon unavailable; stale checkpoint acceptable per policy"
  boundaryContext String?
  /// Array of source identities and observation metadata (JSON)
  /// Each source entry contains: {sourceType, sourceId, observedAt, hash, orderIndex}
  sources       Json // Array<{ sourceType: VerificationProvenanceSourceType, sourceId: string, observedAt: DateTime, hash: string, orderIndex: int, missingLinkReason?: string }>
  /// Total count of sources contributing to decision (for quick aggregation)
  sourceCount   Int
  /// Timestamp when decision was made
  decidedAt     DateTime  @default(now())
  createdAt     DateTime  @default(now())
  verificationProvenanceSources VerificationProvenanceSource[]

  @@unique([proofId, decidedAt])
  @@index([proofId, createdAt])
  @@index([verificationResult])
  @@index([createdAt])
}

/// Individual provenance source record with full lineage metadata.
/// Enables querying "which attestation/payment/contract contributed to proof X?"
/// 
/// Tenant-isolated via proofId foreign key.
/// Privacy-safe: identity only, never payloads.
model VerificationProvenanceSource {
  id             String                          @id @default(cuid())
  provenanceId   String
  provenance     VerificationProvenance          @relation(fields: [provenanceId], references: [id], onDelete: Cascade)
  proofId        String  // Denormalized for queries; foreign key to Proof via provenance
  /// Type of source (CREDENTIAL_SOURCE, BACKEND_OBSERVATION, CONTRACT_OBSERVATION, STELLAR_OBSERVATION)
  sourceType     VerificationProvenanceSourceType
  /// Specific source identity (e.g., paymentId, attestationId, operationId, contractTxHash)
  sourceId       String
  /// Optional human-readable source label (e.g., "PAYMENT_RECEIVED", "CONTRACT_REGISTERED")
  sourceLabel    String?
  /// When this source was observed/queried
  observedAt     DateTime
  /// SHA-256 hash of source metadata (prevents replay/tampering)
  /// Never the raw source payload, always hashed
  sourceHash     String
  /// Sequential position in decision lineage (0-indexed)
  observationOrder Int
  /// Reason if source was unavailable or excluded
  /// e.g., "STALE_CHECKPOINT", "NETWORK_TIMEOUT", "ATTESTATION_EXPIRED", "AUTHORIZATION_DENIED"
  missingLinkReason String?
  /// Reference to originating decision (for audit trail)
  decidedAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([provenanceId, observationOrder])
  @@index([provenanceId, createdAt])
  @@index([proofId, sourceType])
  @@index([sourceId])
  @@index([missingLinkReason])
}

model ApiKey {
  id               String                  @id @default(cuid())
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id])
  createdById      String
  createdBy        User                    @relation(fields: [createdById], references: [id])
  name             String
  prefix           String                  @db.VarChar(8)
  keyHash          String                  @unique
  scopeAssignments ApiKeyScopeAssignment[] @relation("apiKeyScopeAssignments")
  quotas           ApiKeyQuota[]
  status           ResourceStatus          @default(ACTIVE)
  lastUsedAt       DateTime?
  rotatedAt        DateTime?
  revokedAt        DateTime?
  expiresAt        DateTime?
  createdAt        DateTime                @default(now())
  usageSummaries   ApiKeyUsageSummary[]

  @@index([organizationId, status])
  @@index([prefix])
  @@index([organizationId, createdAt, id])
}

model ApiKeyScopeAssignment {
  id       String      @id @default(cuid())
  apiKeyId String
  apiKey   ApiKey      @relation("apiKeyScopeAssignments", fields: [apiKeyId], references: [id], onDelete: Cascade)
  scope    ApiKeyScope

  @@unique([apiKeyId, scope])
}

enum WebhookSecretState {
  ACTIVE
  OVERLAP
  RETIRED
}

model Webhook {
  id                 String                     @id @default(cuid())
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id])
  url                String
  secretEncrypted    String
  events             Json
  predicate          Json?                      // Optional PredicateV1 for bounded event filtering
  status             ResourceStatus             @default(ACTIVE)
  mtlsRequired       Boolean                    @default(false)
  payloadVersion     String                     @default("1")
  revision           Int                        @default(0)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  deliveries         WebhookDelivery[]
  clientCertificates WebhookClientCertificate[]
  circuitBreaker     WebhookCircuit?
  secretVersions     WebhookSecretVersion[]
  tlsProbes          WebhookTlsProbe[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt, id])
}

/**
 * Versioned signing secrets for a webhook.
 *
 * Enables controlled rotation with overlap windows:
 * - ACTIVE: Primary signing key; all new deliveries use this
 * - OVERLAP: Can be used by retries and replays; for window when both keys accepted
 * - RETIRED: No longer used; kept for audit trail
 *
 * keyId is a non-secret identifier returned in signature headers for key identification.
 */
model WebhookSecretVersion {
  id                  String                @id @default(cuid())
  webhookId           String
  webhook             Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  keyId               String                // Non-secret identifier for this key version
  secretEncrypted     String                // AES-256-GCM encrypted signing secret
  state               WebhookSecretState    @default(ACTIVE)
  activatedAt         DateTime              @default(now())
  overlapExpiresAt    DateTime?             // When OVERLAP state expires; becomes RETIRED if set and passes
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([webhookId, keyId])
  @@index([webhookId, state])
  @@index([webhookId, activatedAt])
}

/// Proves control of a webhook destination before real event deliveries begin.
/// Only a SHA-256 hash of the opaque challenge token is stored — the raw token
/// is never written to the database or to any application log. `url` is the
/// destination this challenge was issued for, so a later destination change
/// can be told apart from (and invalidates) challenges issued for the old one.
model WebhookVerificationChallenge {
  id          String    @id @default(cuid())
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id])
  tokenHash   String    @unique
  url         String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([webhookId])
  @@index([expiresAt])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model WebhookDelivery {
  id                String                @id @default(cuid())
  webhookId         String
  webhook           Webhook               @relation(fields: [webhookId], references: [id])
  eventType         String
  eventId           String
  payload           Json
  schemaVersion     String                @default("1")
  payloadBody       String                @default("")
  predicateSnapshot Json?                 // Snapshot of predicate at delivery time (null if no predicate)
  attempt           Int                   @default(1)
  status            WebhookDeliveryStatus @default(PENDING)
  statusCode        Int?
  responseBody      String?
  durationMs        Int?
  failureReason     String?
  replayOf          String?
  replayedBy        String?
  replayKey         String?               @unique
  deliveredAt       DateTime?
  nextRetryAt       DateTime?
  deadLetteredAt    DateTime?
  deadLetterReason  String?
  redrivenAt        DateTime?
  redrivenBy        String?
  redriveReason     String?
  createdAt         DateTime              @default(now())

  @@index([webhookId, createdAt])
  @@index([webhookId, createdAt, id])
  @@index([eventId])
  @@index([status, nextRetryAt])
  @@index([deadLetteredAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorType    String
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  // Tamper-evidence chain fields. Every record belongs to exactly one
  // hash chain, partitioned by `chainKey` (the organization id, or the
  // "SYSTEM" sentinel for records with no organization). `sequence` is a
  // monotonically increasing, gap-free position within that chain, and
  // `hash` binds this record's canonical content to `prevHash` (the prior
  // record's `hash`, or null at chain genesis). `hashVersion` records which
  // canonicalization/hash algorithm produced `hash`, so verification can
  // dispatch on it even after the algorithm evolves.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  chainKey       String        @default("SYSTEM")
  sequence       BigInt        @default(0)
  hashVersion    Int           @default(1)
  prevHash       String?
  hash           String        @default("")

  // Correlation graph fields (#283)
  correlationId  String?
  parentId       String?
  parent         AuditLog?     @relation("AuditLogLineage", fields: [parentId], references: [id])
  children       AuditLog[]    @relation("AuditLogLineage")

  @@unique([chainKey, sequence])
  @@index([actorType, actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, correlationId])
  @@index([parentId])
}

/// Per-chain append cursor for the AuditLog hash chain.
/// Row-level locking on this table (`SELECT ... FOR UPDATE`) is what makes
/// concurrent appends to the same chain safe: a writer holds the lock for
/// the duration of its transaction, so sequence/prevHash assignment for a
/// chain is always derived from a value nobody else can be mutating.
model AuditChainCursor {
  chainKey     String   @id
  lastSequence BigInt   @default(0)
  lastHash     String?
  updatedAt    DateTime @updatedAt
}

model AnchoringIntent {
  id                   String                @id @default(cuid())
  proofId              String
  proof                Proof                 @relation(fields: [proofId], references: [id])
  operation            AnchoringOperation
  status               AnchoringStatus       @default(PENDING)
  attemptCount         Int                   @default(0)
  lastAttemptAt        DateTime?
  nextRetryAt          DateTime?
  transactionHash      String?
  ledger               String?
  lastErrorSafe        String?
  permanentError       Boolean               @default(false)
  /// Set when status transitions to QUARANTINED. Null otherwise.
  quarantinedAt        DateTime?
  quarantineReasonCode QuarantineReasonCode?
  /// The operator's disposition. Only meaningful once quarantined; defaults
  /// to PENDING so a freshly-quarantined intent always has a decision value
  /// to query on.
  quarantineDecision   QuarantineDecision    @default(PENDING)
  /// Opaque id of the operator (a user id) who redrove or abandoned this
  /// intent. Null until a decision is made.
  decidedById          String?
  decidedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([proofId, operation])
  @@index([nextRetryAt])
  @@index([proofId])
  @@index([status, quarantineDecision])
}

enum ProofShareScope {
  /// Verification result and public proof metadata only.
  VERIFY_STATUS
  /// Verification result plus the signed credential.
  VERIFY_CREDENTIAL
}

/// Time-limited, scoped share link for a single proof.
/// Only a SHA-256 hash of the raw token is stored; the raw token is returned
/// once at creation. Scope, proof, owner, expiry and use limit are immutable
/// after issuance (enforced by a database trigger as well as by the service).
model ProofShareToken {
  id             String          @id @default(cuid())
  proofId        String
  proof          Proof           @relation(fields: [proofId], references: [id])
  /// Proof owner at issuance — the tenant boundary for list/revoke/use.
  ownerId        String
  tokenHash      String          @unique
  scope          ProofShareScope
  label          String?
  maxUses        Int?
  useCount       Int             @default(0)
  expiresAt      DateTime
  revokedAt      DateTime?
  /// Set when a newer token for the same proof and scope replaced this one.
  supersededAt   DateTime?
  supersededById String?
  lastUsedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@index([proofId, ownerId])
  @@index([ownerId])
  @@index([expiresAt])
}

/// Fixed-window usage counters for rate-style organization quotas
/// (proof requests per day, payment syncs per hour). Count-style quotas
/// (active API keys, webhooks) are computed from the owning tables instead.
model OrganizationQuotaUsage {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  quota          String
  windowStart    DateTime
  count          Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, quota, windowStart])
  @@index([windowStart])
}

model AuthAuditEvent {
  id                 String        @id @default(cuid())
  eventType          AuthEventType
  walletHash         String
  clientMetadataHash String?
  challengeId        String?
  success            Boolean
  failureReason      String?
  createdAt          DateTime      @default(now())

  @@index([walletHash, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Privileged operation approval queue (#313)
// ---------------------------------------------------------------------------

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  EXECUTED
}

/// A request to perform a privileged, side-effecting operation. Requires an
/// explicit approval decision from someone other than the requester before
/// the operation may be executed, and every decision is terminal.
model ApprovalRequest {
  id                  String                @id @default(cuid())
  operationType       String
  /// Canonical hash of `payload`, used so callers can detect a changed
  /// request before approving it.
  payloadHash         String
  payload             Json
  requestedById       String
  status              ApprovalRequestStatus @default(PENDING)
  decidedById         String?
  decidedAt           DateTime?
  decisionReason      String?
  /// Set the moment execution claims this request, atomically, so a
  /// concurrently-triggered execution cannot run the operation twice.
  executionLeaseToken String?               @unique
  executionLeasedAt   DateTime?
  executedAt          DateTime?
  expiresAt           DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status, expiresAt])
  @@index([requestedById])
  @@index([operationType, status])
}

// ---------------------------------------------------------------------------
// Organization data residency policies (#317)
// ---------------------------------------------------------------------------

enum DataResidencyClass {
  PAYMENT_DATA
  PROOF_DATA
  AUDIT_DATA
  BACKUP_DATA
  QUEUE_DATA
}

enum DataResidencyPolicyStatus {
  ACTIVE
  SUPERSEDED
}

/// A versioned, explicit allow-list of regions an organization permits for a
/// given class of regulated data. Policies are never mutated in place —
/// changing the allow-list creates a new version and supersedes the old one.
model DataResidencyPolicy {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id])
  dataClass      DataResidencyClass
  /// JSON string array of allowed region codes. Explicit allow-list — there
  /// is no implicit default region, so an unmapped data class is denied.
  allowedRegions Json
  version        Int
  status         DataResidencyPolicyStatus @default(ACTIVE)
  supersedesId   String?                   @unique
  createdById    String
  createdAt      DateTime                  @default(now())

  @@unique([organizationId, dataClass, version])
  @@index([organizationId, dataClass, status])
}

/// Tracks which region a concrete piece of org-scoped data (a write, export,
/// backup, queued job, or deployment target) currently lives in, so policy
/// changes can be checked against reality before they take effect.
model DataResidencyAssignment {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  dataClass      DataResidencyClass
  resourceType   String
  resourceId     String
  region         String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, dataClass, resourceType, resourceId])
  @@index([organizationId, dataClass, region])
}

// ---------------------------------------------------------------------------
// Schema import validation with dry-run jobs (#320)
// ---------------------------------------------------------------------------

enum SchemaImportStatus {
  UPLOADED
  DRY_RUN_RUNNING
  DRY_RUN_COMPLETE
  APPROVED
  APPLYING
  APPLIED
  REJECTED
  FAILED
}

/// A bulk schema-metadata import. Upload and dry-run never mutate
/// `SchemaDefinition`; only `apply`, gated on the exact reviewed hash, does.
model SchemaImportJob {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  status         SchemaImportStatus @default(UPLOADED)
  rowCount       Int
  uploadedById   String
  /// Canonical hash of the normalized dry-run result. `apply` must be given
  /// this exact value — it is the "reviewed hash" the caller approved.
  canonicalHash  String?
  conflictCount  Int                @default(0)
  errorCount     Int                @default(0)
  approvedById   String?
  approvedAt     DateTime?
  appliedAt      DateTime?
  failureReason  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  rows           SchemaImportRow[]

  @@index([organizationId, status])
}

/// One row of a schema import, with its normalization result from the
/// dry-run phase. Rows are written during dry-run but never applied to
/// `SchemaDefinition` until the job is approved and applied.
model SchemaImportRow {
  id             String          @id @default(cuid())
  jobId          String
  job            SchemaImportJob @relation(fields: [jobId], references: [id])
  rowIndex       Int
  schemaKey      String
  version        String
  definition     Json
  normalizedHash String
  conflict       Boolean         @default(false)
  errors         Json?

  @@unique([jobId, rowIndex])
  @@index([jobId, conflict])
}

/// The applied, canonical schema metadata. Only written by
/// `SchemaImportsService.apply`.
model SchemaDefinition {
  id          String   @id @default(cuid())
  schemaKey   String
  version     String
  definition  Json
  importJobId String?
  createdAt   DateTime @default(now())

  @@unique([schemaKey, version])
  @@index([schemaKey])
}

// ---------------------------------------------------------------------------
// Webhook mutual TLS authentication (#322)
// ---------------------------------------------------------------------------

enum WebhookCertificateStatus {
  PENDING
  ACTIVE
  ROTATING
  EXPIRED
  REVOKED
}

/// A client certificate usable for mTLS webhook delivery. The private key is
/// encrypted at rest with the same AEAD scheme used for webhook signing
/// secrets and is never exposed through the API or logs.
model WebhookClientCertificate {
  id                  String                   @id @default(cuid())
  webhookId           String
  webhook             Webhook                  @relation(fields: [webhookId], references: [id])
  certificatePem      String
  privateKeyEncrypted String
  fingerprintSha256   String                   @unique
  status              WebhookCertificateStatus @default(PENDING)
  notBefore           DateTime
  notAfter            DateTime
  activatedAt         DateTime?
  retiredAt           DateTime?
  createdAt           DateTime                 @default(now())

  @@index([webhookId, status])
  @@index([notAfter])
}

enum ApiKeyEndpointCategory {
  PROOF
  PAYMENT
  CREDENTIAL
  ORGANIZATION
  AUTH_CONTEXT
  OTHER
}

enum ApiKeyUsageOutcome {
  SUCCESS
  FORBIDDEN
  ERROR
}

/// Privacy-safe per-key, per-category, per-outcome usage summary.
/// Incremented atomically via a raw SQL upsert. Never stores IP addresses,
/// request bodies, path parameters, or user-agent strings.
model ApiKeyUsageSummary {
  id                     String                 @id @default(cuid())
  apiKeyId               String
  apiKey                 ApiKey                 @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  category               ApiKeyEndpointCategory
  outcome                ApiKeyUsageOutcome
  requestCount           BigInt                 @default(0)
  /// Rounded to the nearest minute — recency signal without per-request timing.
  lastUsedAt             DateTime?
  /// Set once when the parent key is revoked. Row is not updated after this.
  revokedSummaryFrozenAt DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([apiKeyId, category, outcome])
  @@index([apiKeyId])
  @@index([lastUsedAt])
}

enum CspDirective {
  DEFAULT_SRC
  SCRIPT_SRC
  STYLE_SRC
  IMG_SRC
  CONNECT_SRC
  FONT_SRC
  FRAME_SRC
  OBJECT_SRC
  MEDIA_SRC
  WORKER_SRC
  MANIFEST_SRC
  BASE_URI
  FORM_ACTION
  FRAME_ANCESTORS
  UPGRADE_INSECURE_REQUESTS
  OTHER
}

/// Coarse frontend page category. Never a path or query string.
enum CspRouteCategory {
  AUTH
  DASHBOARD
  PROOFS
  PAYMENTS
  SETTINGS
  PUBLIC
  OTHER
}

enum CspDisposition {
  ENFORCE
  REPORT
}

/// Privacy-safe, aggregated CSP violation reporting (#336).
/// One row per (directive, routeCategory, release, disposition) combination;
/// a report increments its bucket's count rather than being stored as its
/// own row. Never stores a raw document/blocked URI, DOM data, or user input
/// — the ingestion DTO does not even accept those fields.
model CspViolationSummary {
  id            String           @id @default(cuid())
  directive     CspDirective
  routeCategory CspRouteCategory
  /// Frontend-reported app release/version string. Bounded format, not a
  /// closed enum — see FIELD_LIMITS.cspRelease and the DTO's validator.
  release       String
  disposition   CspDisposition
  count         BigInt           @default(0)
  firstSeenAt   DateTime         @default(now())
  /// Rounded down to the nearest minute, like ApiKeyUsageSummary.lastUsedAt,
  /// so individual report timing cannot be reconstructed from storage.
  lastSeenAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([directive, routeCategory, release, disposition])
  @@index([lastSeenAt])
}

/// Replay-protection nonce store for signed API requests.
/// Each row represents a nonce that has been consumed within the active clock window.
/// Rows are valid only until expiresAt; a background job (or query-time filter) purges expired rows.
/// NEVER stores IP addresses, request bodies, or user agents.
model RequestNonce {
  id        String   @id @default(cuid())
  /// SHA-256 hex digest of (keyId || ":" || rawNonce) — prevents enumeration of raw nonce values.
  nonceHash String   @unique
  /// The key that presented this nonce, for scoped uniqueness and cleanup.
  apiKeyId  String
  /// When this nonce record expires (= request timestamp + clockWindowSeconds).
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([apiKeyId, expiresAt])
}

/// Acknowledgement for an expected / planned contract configuration drift.
/// Allows operators to suppress blocking drift during upgrades for a bounded window.
model ContractDriftAcknowledgement {
  id             String   @id @default(cuid())
  /// The drift key being acknowledged, e.g. "schema_version_mismatch" or "contract_address_changed".
  driftKey       String
  /// Who acknowledged it (actorId from the audit system — never raw PII).
  acknowledgedBy String
  /// Human-readable note stored for the audit trail.
  note           String
  /// When this acknowledgement expires. After this time it is ignored.
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([driftKey, expiresAt])
}

/// Immutable history of payment classification changes.
/// Used for auditability and proof eligibility reconstruction.
model PaymentClassificationHistory {
  id                     String                @id @default(cuid())
  paymentId              String
  payment                Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actorId                String
  previousClassification PaymentClassification
  newClassification      PaymentClassification
  reasonCode             String
  classificationRevision Int
  createdAt              DateTime              @default(now())

  @@index([paymentId, createdAt])
  @@index([actorId, createdAt])
  @@index([classificationRevision])
}

/// Bounded bulk organization membership import jobs.
model MembershipImportJob {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User                     @relation("CreatedImportJobs", fields: [createdById], references: [id])
  version        String                   @default("1.0")
  filename       String?
  rowCount       Int
  status         MembershipImportStatus   @default(PENDING)
  progress       Int                      @default(0)
  cancelledAt    DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  results        MembershipImportResult[]

  @@index([organizationId, status])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

/// Per-row results for membership import jobs.
/// Maintains input ordering and provides detailed feedback.
model MembershipImportResult {
  id            String                    @id @default(cuid())
  importJobId   String
  importJob     MembershipImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowIndex      Int
  walletAddress String
  requestedRole OrganizationMemberRole
  result        MembershipImportRowResult
  reasonCode    String?
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime                  @default(now())

  @@unique([importJobId, rowIndex])
  @@index([importJobId, rowIndex])
  @@index([result])
}

/// Periodic organization access review campaign.
/// Captures membership snapshot for review decisions.
model AccessReviewCampaign {
  id              String                     @id @default(cuid())
  organizationId  String
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User                       @relation("CreatedAccessReviews", fields: [createdById], references: [id])
  name            String
  description     String?
  status          AccessReviewCampaignStatus @default(OPEN)
  snapshotVersion Int
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  entries         AccessReviewEntry[]

  @@index([organizationId, status])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

/// Individual review entries for organization members.
/// Links to membership snapshot and tracks decisions.
model AccessReviewEntry {
  id               String                  @id @default(cuid())
  campaignId       String
  campaign         AccessReviewCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  memberId         String
  member           OrganizationMember      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  snapshotRole     OrganizationMemberRole
  decision         AccessReviewDecision?
  recommendedRole  OrganizationMemberRole?
  reviewedById     String?
  reviewedBy       User?                   @relation("ReviewedAccessEntries", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  appliedAt        DateTime?
  conflictDetected Boolean                 @default(false)
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([campaignId, memberId])
  @@index([campaignId, decision])
  @@index([memberId])
  @@index([reviewedById, reviewedAt])
}

/// Webhook circuit breaker state per endpoint.
/// Tracks failure counts and recovery windows.
model WebhookCircuit {
  id                    String              @id @default(cuid())
  webhookId             String              @unique
  webhook               Webhook             @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  state                 WebhookCircuitState @default(CLOSED)
  failureCount          Int                 @default(0)
  failureThreshold      Int                 @default(5)
  lastFailureAt         DateTime?
  openedAt              DateTime?
  halfOpenAt            DateTime?
  lastSuccessAt         DateTime?
  recoveryWindowMs      Int                 @default(300000)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([state, openedAt])
  @@index([webhookId, state])
}

/// Short-lived, action-bound assertion issued after wallet re-verification.
/// Consumed (single-use) when the destructive operation succeeds.
/// Bound to: userId, action, resourceId (or "*"), origin, network.
/// Never stores the raw assertion token — only a SHA-256 hash.
model RecentAuthAssertion {
  id         String    @id @default(cuid())
  /// SHA-256 hex digest of the raw opaque assertion token.
  tokenHash  String    @unique
  userId     String
  /// The destructive action this assertion authorises, e.g. "org:delete".
  action     String
  /// The resource ID this assertion is bound to, or "*" for any resource.
  resourceId String
  /// SHA-256 of the Origin header at issuance time (never the raw value).
  originHash String
  /// Stellar network passphrase at issuance time.
  network    String
  expiresAt  DateTime
  /// Set when the assertion is consumed by a destructive operation.
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, action, usedAt])
  @@index([expiresAt])
}

/// API key quota configuration per scope.
/// Defines rate limits specific to each scope an API key can use.
/// Supports unlimited (null limit), disabled (0 limit), and finite quotas.
model ApiKeyQuota {
  id            String      @id @default(cuid())
  apiKeyId      String
  apiKey        ApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  scope         ApiKeyScope
  /// Quota limit: null = unlimited, 0 = disabled, positive = requests per window
  quotaLimit    Int?
  /// Rolling window in seconds
  windowSeconds Int         @default(3600)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([apiKeyId, scope])
  @@index([apiKeyId])
}

/// Privacy-safe proof sharing access events.
/// Records sharing token usage outcomes without storing raw tokens or verifier identities.
/// Retention is independent from general verification events.
model ProofSharingEvent {
  id             String         @id @default(cuid())
  proofId        String
  proof          Proof          @relation(fields: [proofId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the sharing token - never stores raw token
  tokenHash      String
  /// SHA-256 hash of anonymized IP address (subnet level)
  ipHash         String?
  /// SHA-256 hash of user agent string
  userAgentHash  String?
  /// Access outcome
  outcome        SharingOutcome
  /// Purpose of the sharing request (sanitized)
  purpose        String?
  /// Who requested the sharing token
  requestedBy    String?
  createdAt      DateTime       @default(now())
  /// When this event should be purged for data retention
  expiresAt      DateTime

  @@index([organizationId, proofId, createdAt])
  @@index([proofId, createdAt])
  @@index([expiresAt])
}

/// Immutable policy versions with content hash commitments.
/// Each published version has a unique content hash for tamper detection.
model PolicyVersion {
  id          String       @id @default(cuid())
  policyType  PolicyType
  version     String
  /// SHA-256 hash of the exact policy content accepted
  contentHash String
  status      PolicyStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([policyType, version])
  @@index([policyType, status])
  @@index([policyType, publishedAt])
}

/// Immutable consent acceptance and withdrawal history.
/// Preserves audit trail of policy version acceptance by authenticated users.
model ConsentRecord {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyType     PolicyType
  policyVersion  String
  /// Content hash from PolicyVersion - ensures integrity
  contentHash    String
  action         ConsentAction
  createdAt      DateTime      @default(now())

  @@index([userId, policyType, createdAt])
  @@index([organizationId, userId])
  @@index([userId, policyType, action, createdAt])
}

/// Signed proof disclosure consent receipts.
/// Stores receipt metadata and cryptographic commitments without duplicating proof data.
model DisclosureReceipt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proofId        String
  proof          Proof        @relation(fields: [proofId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the canonical receipt payload
  receiptHash    String       @unique
  /// Signature data: { signature, keyVersion, algorithm, metadata }
  signatureData  Json
  /// When this receipt expires and becomes invalid
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId, proofId])
  @@index([organizationId, createdAt])
}

/// Migration deployment lease for preventing concurrent migration execution.
/// Only one deployment may hold the migration lease at a time.
/// Uses both PostgreSQL advisory locks for mutual exclusion and persisted state for observability.
model MigrationLease {
  id             String   @id @default("migration_deployment")
  /// Process/deployment identifier holding the lease (hostname, container ID, etc).
  ownerId        String
  /// When the lease was acquired.
  acquiredAt     DateTime @default(now())
  /// When the lease expires and can be recovered by another deployment.
  expiresAt      DateTime
  /// Current migration state/version being processed.
  migrationState String?
  /// Last successful migration version completed.
  lastVersion    String?
  /// Whether migration execution is currently active.
  isActive       Boolean  @default(true)
  /// Deployment/process metadata for debugging.
  ownerMetadata  Json?
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

/// Proof state reconciliation checkpoints for tracking contract synchronization progress.
model ProofReconciliationCheckpoint {
  id                   String    @id @default("proof_reconciliation")
  /// Contract address being reconciled.
  contractId           String
  /// Stellar network (testnet, mainnet, etc).
  network              String
  /// Last processed ledger sequence number.
  lastLedger           BigInt?
  /// Last processed event cursor/position.
  lastEventCursor      String?
  /// Contract schema version being processed.
  contractVersion      String?
  /// Reconciliation progress state.
  syncState            String    @default("PENDING")
  /// Last successful reconciliation timestamp.
  lastSyncedAt         DateTime?
  /// Any reconciliation errors for visibility.
  lastError            String?
  /// Number of events processed in last run.
  eventsProcessed      Int       @default(0)
  /// Number of conflicts quarantined.
  conflictsQuarantined Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([contractId, network])
  @@index([lastSyncedAt])
}

/// Issuer state reconciliation checkpoints for tracking registry synchronization progress.
model IssuerReconciliationCheckpoint {
  id                   String    @id @default("issuer_reconciliation")
  /// Registry contract address being reconciled.
  contractId           String
  /// Stellar network (testnet, mainnet, etc).
  network              String
  /// Last processed ledger sequence number.
  lastLedger           BigInt?
  /// Last processed event cursor/position.
  lastEventCursor      String?
  /// Contract schema version being processed.
  contractVersion      String?
  /// Reconciliation progress state.
  syncState            String    @default("PENDING")
  /// Last successful reconciliation timestamp.
  lastSyncedAt         DateTime?
  /// Any reconciliation errors for visibility.
  lastError            String?
  /// Number of events processed in last run.
  eventsProcessed      Int       @default(0)
  /// Number of conflicts quarantined.
  conflictsQuarantined Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([contractId, network])
  @@index([lastSyncedAt])
}

enum ReconciliationConflictType {
  STATE_MISMATCH
  UNKNOWN_EVENT_VERSION
  REORG_DETECTED
  CONTRACT_REPLACEMENT
  INVALID_TRANSITION
}

enum ReconciliationConflictStatus {
  QUARANTINED
  RESOLVED
  IGNORED
}

/// Quarantine for reconciliation conflicts that cannot be resolved automatically.
model ReconciliationConflict {
  id               String                       @id @default(cuid())
  /// Type of reconciliation (proof, issuer).
  resourceType     String
  /// Resource ID (proof ID, issuer ID).
  resourceId       String
  /// Contract address where conflict occurred.
  contractId       String
  /// Stellar network.
  network          String
  /// Type of conflict detected.
  conflictType     ReconciliationConflictType
  /// Current resolution status.
  status           ReconciliationConflictStatus @default(QUARANTINED)
  /// Event/ledger position where conflict occurred.
  eventPosition    String?
  /// Observed contract state that conflicts.
  contractState    Json?
  /// Local state that conflicts.
  localState       Json?
  /// Additional context for debugging.
  metadata         Json?
  /// When conflict was detected.
  detectedAt       DateTime                     @default(now())
  /// When conflict was resolved (if resolved).
  resolvedAt       DateTime?
  /// Resolution method/reason.
  resolutionReason String?
  /// Who resolved it (for audit).
  resolvedBy       String?

  @@index([resourceType, resourceId])
  @@index([contractId, network])
  @@index([status, detectedAt])
  @@index([conflictType])
}

enum DisputeStatus {
  OPEN
  ASSIGNED
  RESOLVED
  WITHDRAWN
}

enum DisputeCategory {
  ACCURACY
  FRAUD
  TECHNICAL
  COMPLIANCE
  OTHER
}

enum CredentialVerificationKeyTrustPinStatus {
  ACTIVE
  RETIRED
  REVOKED
}

/// Proof dispute workflow for business/audit review process.
/// This is separate from cryptographic verification - disputes are business workflow.
model ProofDispute {
  id                 String          @id @default(cuid())
  /// Organization that owns this dispute (tenant isolation).
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Proof being disputed.
  proofId            String
  proof              Proof           @relation(fields: [proofId], references: [id], onDelete: Restrict)
  /// Dispute category for classification.
  category           DisputeCategory
  /// Current lifecycle status.
  status             DisputeStatus   @default(OPEN)
  /// Hash/commitment of evidence (not raw evidence).
  evidenceCommitment String?
  /// Actor who submitted the dispute.
  submittedBy        String
  /// Actor assigned to review (if assigned).
  assignedTo         String?
  /// Resolution outcome/reason.
  resolutionOutcome  String?
  /// Resolution details.
  resolutionReason   String?
  /// Actor who resolved the dispute.
  resolvedBy         String?
  /// When dispute was submitted.
  submittedAt        DateTime        @default(now())
  /// When dispute was assigned (if assigned).
  assignedAt         DateTime?
  /// When dispute was resolved (if resolved).
  resolvedAt         DateTime?
  /// When dispute was withdrawn (if withdrawn).
  withdrawnAt        DateTime?
  /// Additional metadata (bounded).
  metadata           Json?

  @@unique([proofId, category, status], name: "one_active_dispute_per_proof_category", map: "proof_dispute_unique_active")
  @@index([organizationId])
  @@index([proofId])
  @@index([status])
  @@index([submittedBy])
  @@index([assignedTo])
  @@index([submittedAt])
}

// ---------------------------------------------------------------------------
// Organization Data Exports (#200)
// ---------------------------------------------------------------------------

enum OrganizationExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum OrganizationExportCategory {
  ORGANIZATION_PROFILE
  ISSUERS
  API_KEYS
  WEBHOOKS
  AUDIT_LOGS
}

model OrganizationExportJob {
  id                String                       @id @default(cuid())
  organizationId    String
  organization      Organization                 @relation(fields: [organizationId], references: [id])
  requestedById     String
  categories        OrganizationExportCategory[]
  status            OrganizationExportStatus     @default(QUEUED)
  attemptCount      Int                          @default(0)
  artifactPath      String?
  archiveDigest     String?
  sizeBytes         Int?
  errorCategory     String?
  downloadTokenHash String?                      @unique
  downloadExpiresAt DateTime?
  expiresAt         DateTime
  requestedAt       DateTime                     @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([organizationId, requestedAt])
  @@index([status, expiresAt])
}

enum PaymentBackfillStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

model PaymentBackfillJob {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id])
  requestedById     String
  startLedger       Int
  endLedger         Int
  status            PaymentBackfillStatus @default(PENDING)
  checkpointCursor  String?
  /// Account to scan (#321). NULL for legacy jobs, which scan the user's wallet.
  accountId         String?               @db.VarChar(56)
  pagesProcessed    Int                   @default(0)
  recordsSeen       Int                   @default(0)
  paymentsCreated   Int                   @default(0)
  duplicatesSkipped Int                   @default(0)
  attempts          Int                   @default(0)
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  cancelRequestedAt DateTime?
  lastErrorSafe     String?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

