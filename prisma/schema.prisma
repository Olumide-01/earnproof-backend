// ---------------------------------------------------------------------------
// Contract Successor Migration Readiness Assessment (#306)
// ---------------------------------------------------------------------------

/// Enum for contract successor finding acknowledgement states.
/// Used to track lifecycle of operator acknowledgements for readiness findings.
enum SuccessorFindingSeverity {
  BLOCKING
  ADVISORY
  INFORMATIONAL
}

/// Acknowledgements of contract successor readiness findings.
/// Operators can acknowledge expected blocking findings for a bounded time (max 7 days).
/// This allows planned migrations to proceed despite temporary conditions.
model ContractSuccessorFindingAcknowledgement {
  id             String   @id @default(cuid())
  /// Fully-qualified finding key: network:contractId:findingKey
  findingKey     String
  /// Who acknowledged it (actorId from the audit system — never raw PII).
  acknowledgedBy String
  /// Human-readable note stored for the audit trail.
  note           String
  /// When this acknowledgement expires. After this time it is ignored.
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([findingKey, expiresAt])
  @@index([acknowledgedBy, createdAt])
}

/// Contract successor migration checkpoint.
/// Immutable record of passed/failed validation gates during successor assessment.
/// Each successful assessment creates a new checkpoint for audit trail.
model ContractSuccessorMigrationCheckpoint {
  id             String   @id @default(cuid())
  /// Composite key: network:contractId
  contractKey    String
  network        String
  contractId     String
  /// Ledger sequence observed during checkpoint validation
  observedLedger BigInt
  /// Which validation gates were passed (JSON array)
  passedGates    String[]
  /// Which validation gates failed (JSON array)
  failedGates    String[]
  /// Who initiated the checkpoint (actorId from audit system)
  initiatedBy    String
  createdAt      DateTime @default(now())

  @@unique([network, contractId, observedLedger])
  @@index([network, contractId, createdAt])
  @@index([observedLedger])
}

/// Contract successor readiness assessment cache.
/// Stores the last assessed readiness state for each successor contract.
/// Cache is invalidated when acknowledgements change or assessment ages beyond threshold.
model ContractSuccessorReadinessCache {
  id             String   @id @default(cuid())
  /// Composite key: network:contractId:version
  cacheKey       String   @unique
  network        String
  contractId     String
  expectedVersion Int
  /// Latest assessment verdict: ready | not_ready
  status         String   @db.VarChar(16)
  /// Reason if not ready (deterministic status code, never raw error)
  reason         String?
  /// Serialized findings (JSON array)
  findings       Json
  /// Overall severity: blocking | advisory | informational | none
  overall        String   @db.VarChar(16)
  /// When the assessment was performed
  assessedAt     DateTime
  /// Latest passed checkpoint (JSON)
  latestCheckpoint Json?
  /// How long the assessment remains valid (ms)
  cacheTtlMs     Int      @default(5000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([network, contractId])
  @@index([status, createdAt])
  @@index([updatedAt])
}

/// Contract identity and versioning for successor tracking.
/// Maps network + contractId to schema versions for compatibility checks.
model ContractVersion {
  id             String   @id @default(cuid())
  network        String
  contractId     String
  /// Schema version deployed on this contract
  schemaVersion  Int
  /// When this version was observed live
  observedAt     DateTime
  /// Ledger sequence when first observed
  observedLedger BigInt?
  /// Whether this version is still current
  isCurrent      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([network, contractId, schemaVersion])
  @@index([network, contractId, isCurrent])
  @@index([network, isCurrent])
}

// ---------------------------------------------------------------------------
// Credential Quarantine and Release (Issue #324)
// ---------------------------------------------------------------------------
// Isolate malformed, unknown-key, policy-conflicting, or suspicious imported
// credentials before they can be used in normal verification. Provides a safe
// path to release, reject, or expire them.

/// Quarantined credential record: bounded metadata only, never raw credential content.
model CredentialQuarantine {
  // Identity & Scope
  id                        String                           @id @default(cuid())
  organizationId            String
  organization              Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenantId                  String  // Denormalized for tenant queries

  // Quarantine Reason & State
  reason                    CredentialQuarantineReasonCode
  state                     CredentialQuarantineState        @default(QUARANTINED)

  // Bounded Metadata (safe allowlist only; never raw credential)
  contentHash               String                          // SHA-256(canonical credential)
  contentSize               Int                             // Byte size of original credential
  schemaType                String                          @db.VarChar(100)  // "EarnProofMinimumIncomeCredential"
  schemaVersion             String                          @db.VarChar(64)   // "earnproof.minimum-income.v1"

  // Issuer metadata (from credential, not live lookup)
  issuerIdentifier          String                          @db.VarChar(255)  // Issuer name or DID (safe to log)
  issuerPolicyVersion       Int?                                              // Issuer policy version at intake time

  // Credential metadata (from parsed credential, verified safe)
  credentialProofType       String?                         @db.VarChar(64)   // "MINIMUM_INCOME", "RECURRING_INCOME", etc.
  credentialExpiresAt       DateTime?                                         // expiresAt from credential claim
  credentialIssuedAt        DateTime?                                         // issuedAt from credential claim

  // Key metadata (if trust pin was involved)
  keyId                     String?                         @db.VarChar(255)  // Key identifier from proof block
  keyType                   String?                         @db.VarChar(64)   // "Ed25519" or "HMAC-SHA256"
  network                   String?                         @db.VarChar(64)   // "public" or "testnet" (from Ed25519 proofs)

  // Evidence & Freshness
  evidenceRefreshedAt       DateTime?                                         // When trust evidence was last fetched
  evidenceFreshUntil        DateTime?                                         // When evidence is no longer usable for release
  evidenceRefreshReason     String?                         @db.VarChar(255)  // Optional note on refresh

  // Release Decision Metadata (filled when state != QUARANTINED)
  decidedByUserId           String?
  decidedBy                 User?                           @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull, name: "quarantine_decidedBy")
  decidedAt                 DateTime?                                         // When the decision was made
  decisionReason            String?                         @db.VarChar(1024) // Free-form reason for rejection/release

  // Audit & Concurrency
  importedByUserId          String
  importedBy                User                            @relation(fields: [importedByUserId], references: [id], onDelete: Restrict, name: "quarantine_importedBy")
  importedAt                DateTime                        @default(now())

  expiresAt                 DateTime                                          // Absolute deadline for quarantine (auto-expire to EXPIRED)
  revision                  Int                             @default(1)       // Optimistic concurrency control

  auditTrail                CredentialQuarantineAudit[]

  updatedAt                 DateTime                        @updatedAt
  createdAt                 DateTime                        @default(now())

  // Indexes
  @@index([organizationId, state])
  @@index([organizationId, createdAt])
  @@index([organizationId, expiresAt, state])
  @@index([contentHash])  // For deduplication check
  @@index([state, expiresAt])  // For expiry job
  @@index([decidedByUserId])
  
  // Unique constraint: prevent duplicate active quarantines for same credential per org
  @@unique([organizationId, contentHash], name: "quarantine_org_hash_active", map: "CredentialQuarantine_org_hash_state_unique")
}

/// Immutable audit trail for credential quarantine state changes and actions.
model CredentialQuarantineAudit {
  id                        String                          @id @default(cuid())
  quarantineId              String
  quarantine                CredentialQuarantine            @relation(fields: [quarantineId], references: [id], onDelete: Restrict)
  organizationId            String
  organization              Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict, name: "quarantine_audit_org")

  // Event
  event                     String                          @db.VarChar(64)   // "QUARANTINED", "RELEASED", "REJECTED", "EXPIRED", "EVIDENCE_REFRESHED"
  actor                     String
  actorUser                 User                            @relation(fields: [actor], references: [id], onDelete: Restrict, name: "quarantine_audit_actor")
  actorRole                 UserRole

  // Event Details
  previousState             CredentialQuarantineState?
  newState                  CredentialQuarantineState?
  changeReason              String?                         @db.VarChar(512)   // Why the state changed

  // Evidence refresh details (if event = EVIDENCE_REFRESHED)
  evidenceResult            String?                         @db.VarChar(255)   // "FRESH", "STALE", "FETCH_FAILED", "VALIDATION_PASSED", etc.

  // Approval linkage (if event = RELEASED or REJECTED)
  approvalRequestId         String?                                            // Link to approval request (if four-eyes used)

  createdAt                 DateTime                        @default(now())

  // Indexes
  @@index([quarantineId, createdAt])
  @@index([organizationId, event, createdAt])
  @@index([actor, createdAt])
  @@index([event])
}


// ---------------------------------------------------------------------------
// Purpose Declarations (Issue #325)
// ---------------------------------------------------------------------------

/// A purpose is a restriction and an accountability record that limits
/// disclosure scope. It never grants access by itself. Organizations must
/// have approved purpose declarations bound to disclosure scope, verifier
/// context, expiry, and audit evidence, before verification runs under
/// policies configured to require them.
///
/// Purpose definitions are versioned: v1, v2, etc. Versions are immutable
/// once any declaration references them. A new version is created if changes
/// are needed.
model PurposeDefinition {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  
  /// Stable purpose identifier within the organization (e.g., "income_verification").
  /// Combined with organizationId and version, uniquely identifies a purpose version.
  purposeKey        String              @db.VarChar(128)
  
  /// Version counter: 1, 2, 3, etc. Immutable once declared.
  version           Int
  
  /// Human-readable description of what this purpose authorizes (bounded to 500 chars).
  /// E.g., "Verify employment income for loan application"
  description       String              @db.VarChar(500)
  
  /// Disclosure scope this purpose is limited to (JSON).
  /// E.g., { "proofTypes": ["AGGREGATE_EARNINGS"], "maxAmount": 100000 }
  disclosureScope   Json
  
  /// Lifecycle markers
  createdAt         DateTime            @default(now())
  deactivatedAt     DateTime?           /// When this version was superseded or retired
  
  declarations      PurposeDeclaration[]
  
  @@unique([organizationId, purposeKey, version])
  @@index([organizationId, createdAt])
}

/// A declaration binds an organization and verifier to a purpose definition,
/// with approval state, expiry, and audit evidence. A declaration is valid
/// only if: approved, not revoked, not expired, bound to the same org and
/// verifier context as the request, and its disclosure scope is a subset of
/// the policy's allowed scope.
model PurposeDeclaration {
  id                    String                             @id @default(cuid())
  organizationId        String
  organization          Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  
  /// Foreign key to the purpose definition version.
  purposeDefinitionId   String
  purposeDefinition     PurposeDefinition                  @relation(fields: [purposeDefinitionId], references: [id], onDelete: Restrict)
  
  /// Verifier context: organization that will perform verifications under this purpose.
  /// Always equal to organizationId for now; permits future multi-tenant scenarios.
  verifierOrganizationId String
  
  /// Approval state: PENDING, APPROVED, REVOKED, or EXPIRED (derived from expiresAt).
  approvalState         PurposeDeclarationApprovalState  @default(PENDING)
  
  /// Approval timestamp and approver. Must be an ADMIN or OWNER of the organization,
  /// and NOT the requester (independent approval). Null if state is PENDING.
  approvedAt            DateTime?
  approvedById          String?
  approvedBy            User?                             @relation(fields: [approvedById], references: [id], onDelete: SetNull, name: "declaration_approvedBy")
  
  /// Revocation timestamp and revoker. Takes effect immediately for new verifications.
  revokedAt             DateTime?
  revokedById           String?
  revokedBy             User?                             @relation(fields: [revokedById], references: [id], onDelete: SetNull, name: "declaration_revokedBy")
  
  /// Expiry timestamp. A declaration is invalid if now() >= expiresAt.
  /// Boundary rule: evaluates once at request start and recorded in audit entry.
  expiresAt             DateTime
  
  /// Optimistic concurrency version counter. Incremented on every state change
  /// (approve, revoke). Ensures simultaneous approve/revoke produce exactly one winner.
  revision              Int                               @default(1)
  
  /// Audit: creation context
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  
  /// Audit trail of this declaration's lifecycle (approvals, revocations, etc.)
  auditEntries          DeclarationAuditEntry[]
  
  /// Verification events that used this declaration
  verificationEvents    VerificationEvent[]               @relation("verification_declaration")
  
  @@unique([organizationId, purposeDefinitionId, verifierOrganizationId])
  @@index([organizationId, approvalState])
  @@index([organizationId, expiresAt])
  @@index([organizationId, approvalState, expiresAt])
  @@index([verifierOrganizationId])
}

/// Immutable audit trail of declaration lifecycle events: creation, approval,
/// revocation, expiry. Enables forensics and compliance.
model DeclarationAuditEntry {
  id                  String              @id @default(cuid())
  declarationId       String
  declaration         PurposeDeclaration  @relation(fields: [declarationId], references: [id], onDelete: Restrict)
  organizationId      String
  
  /// Event type: CREATED, APPROVED, REVOKED, EXPIRED
  event               String              @db.VarChar(32)
  
  /// Actor: user ID who performed the action (or "SYSTEM" for automated expiry)
  actorUserId         String?
  actor               User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  
  /// Previous and new approval state
  previousState       PurposeDeclarationApprovalState?
  newState            PurposeDeclarationApprovalState?
  
  /// Reason for the action (e.g., "Loan application approved", "Duplicate purpose")
  reason              String?             @db.VarChar(500)
  
  /// Request fingerprint (idempotency): hash of (event, actor, reason) to detect
  /// replayed approval/revoke requests. Same request = same fingerprint = idempotent.
  requestFingerprint  String?
  
  /// Metadata (JSON): version at time of event, scope applied, outcome, etc.
  metadata            Json?
  
  createdAt           DateTime            @default(now())
  
  @@index([declarationId, createdAt])
  @@index([organizationId, event, createdAt])
  @@index([actorUserId])
}

/// Verification policies can require a valid purpose declaration before
/// verification runs. This flag controls whether a policy requires purpose
/// enforcement. Policies without this flag behave exactly as before.
model VerificationPolicy {
  id                              String              @id @default(cuid())
  organizationId                  String
  organization                    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  
  /// Policy name (e.g., "loan_income_verification")
  name                            String              @db.VarChar(128)
  
  /// If TRUE, all verifications under this policy must have a valid,
  /// approved purpose declaration matching the organization and verifier.
  /// If FALSE (default), purpose enforcement is not required; existing
  /// behavior is preserved (backward compatible).
  requiresPurposeDeclaration      Boolean             @default(false)
  
  /// Policy version or revision for versioning
  version                         Int                 @default(1)
  
  /// Policy configuration (JSON): proof types, scope, etc.
  config                          Json?
  
  status                          ResourceStatus      @default(ACTIVE)
  
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @updatedAt
  
  @@unique([organizationId, name])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Organization role approval policies (#298)
// ---------------------------------------------------------------------------

enum RoleApprovalPolicyStatus {
  ACTIVE
  SUPERSEDED
}

/// A versioned dual-control policy for organization role changes. Versions are
/// never edited in place: an update supersedes the ACTIVE version and creates
/// the next one, so history is append-only. An organization with no row is
/// governed by the platform default policy, reported as version 0.
model OrganizationRoleApprovalPolicy {
  id                               String                   @id @default(cuid())
  organizationId                   String
  organization                     Organization             @relation(fields: [organizationId], references: [id])
  version                          Int
  status                           RoleApprovalPolicyStatus @default(ACTIVE)
  /// JSON array of OrganizationMemberRole values whose grant or removal
  /// requires approval. Always a superset of the platform-protected roles.
  protectedRoles                   Json
  /// JSON array of OrganizationMemberRole values allowed to approve.
  approverRoles                    Json
  requiredApprovals                Int
  approvalExpiryMinutes            Int
  /// When true, a change that grants or removes OWNER needs an OWNER approver.
  ownerChangesRequireOwnerApproval Boolean
  supersedesId                     String?                  @unique
  createdById                      String
  createdAt                        DateTime                 @default(now())

  @@unique([organizationId, version])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Audit retention legal holds (#311)
// ---------------------------------------------------------------------------

enum AuditLegalHoldScope {
  ORGANIZATION
  PLATFORM
}

enum AuditLegalHoldAuthority {
  COURT_ORDER
  REGULATOR_REQUEST
  LITIGATION_COUNSEL
  INTERNAL_INVESTIGATION
}

enum AuditLegalHoldStatus {
  PENDING_APPROVAL
  ACTIVE
  RELEASE_PENDING
  RELEASED
  REJECTED
}

/// Suspends retention cleanup for audit records in a bounded time range.
///
/// Deliberately carries no case narrative: the reason is stored only as a
/// SHA-256 commitment the requester computed, so the record proves which
/// reason was cited without disclosing it. Every hold expires; renewal is a
/// new hold with its own approval.
model AuditLegalHold {
  id                   String                  @id @default(cuid())
  scope                AuditLegalHoldScope
  /// Required for ORGANIZATION scope, null for PLATFORM scope.
  organizationId       String?
  organization         Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authority            AuditLegalHoldAuthority
  /// Lowercase hex SHA-256 commitment to the hold reason.
  reasonCommitment     String                  @db.Char(64)
  /// Inclusive bounds on AuditLog.createdAt covered by the hold.
  rangeStart           DateTime
  rangeEnd             DateTime
  status               AuditLegalHoldStatus    @default(PENDING_APPROVAL)
  /// Optimistic-concurrency revision, incremented by every transition.
  revision             Int                     @default(0)
  requestedById        String
  /// A pending hold protects records until this instant, then lapses.
  approvalDeadline     DateTime
  approvedById         String?
  approvedAt           DateTime?
  rejectedById         String?
  rejectedAt           DateTime?
  releaseRequestedById String?
  releaseRequestedAt   DateTime?
  releasedById         String?
  releasedAt           DateTime?
  /// The hold stops protecting records at this instant (exclusive).
  expiresAt            DateTime
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([status, expiresAt])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Webhook endpoint TLS posture (#315)
// ---------------------------------------------------------------------------

enum WebhookTlsProbeOutcome {
  HEALTHY
  EXPIRING_SOON
  EXPIRED
  NOT_YET_VALID
  HOSTNAME_MISMATCH
  UNTRUSTED
  WEAK_PROTOCOL
  HANDSHAKE_FAILED
  DESTINATION_BLOCKED
  UNREACHABLE
  TIMEOUT
}

/// One TLS handshake probe of a webhook endpoint. Bounded per webhook; holds
/// only the outcome category and public certificate facts, never the resolved
/// address or a raw error message.
model WebhookTlsProbe {
  id                     String                 @id @default(cuid())
  webhookId              String
  webhook                Webhook                @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  outcome                WebhookTlsProbeOutcome
  /// Negotiated protocol, e.g. "TLSv1.3". Null when no handshake completed.
  protocol               String?                @db.VarChar(16)
  certificateNotBefore   DateTime?
  certificateNotAfter    DateTime?
  /// Colon-separated SHA-256 fingerprint of the leaf certificate.
  certificateFingerprint String?                @db.VarChar(95)
  /// True when this probe raised an alert (the outcome changed to a non-healthy one).
  alerted                Boolean                @default(false)
  durationMs             Int
  probedAt               DateTime

  @@index([webhookId, probedAt])
  @@index([outcome, probedAt])
}
